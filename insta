        """
        
        await update.message.reply_text(
            help_text,
            parse_mode=ParseMode.MARKDOWN,
            disable_web_page_preview=True
        )
    
    async def info_command(self, update: Update, context: CallbackContext):
        """Handle /info and /search commands"""
        if not context.args:
            await update.message.reply_text(
                "❌ *Please provide a Telegram username.*\n\n"
                "*Example:*\n"
                "`/info IMMU_DONN`\n"
                "`/search username`\n\n"
                "Or simply send the username directly.",
                parse_mode=ParseMode.MARKDOWN
            )
            return
        
        username = ' '.join(context.args)
        await self.process_username(update, context, username)
    
    async def about_command(self, update: Update, context: CallbackContext):
        """Show about information"""
        about_text = """
*🤖 About Telegram Info Bot*

*Version:* 1.0.0
*Developer:* Information Services
*API Source:* External Telegram Info API

*Features:*
• Fetches Telegram profile information
• Shows profile details and stats
• Displays linked channels/groups
• Provides profile analysis

*Data Source:*
Uses public Telegram API through third-party service.

