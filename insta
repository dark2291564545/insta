• Only works with public profiles
• No data storage
• Respects user privacy

*⚠️ Disclaimer:*
This bot provides publicly available information only.
Use responsibly and respect privacy.
        """
        
        await update.message.reply_text(
            about_text,
            parse_mode=ParseMode.MARKDOWN,
            disable_web_page_preview=True
        )
    
    async def handle_message(self, update: Update, context: CallbackContext):
        """Handle regular text messages (username input)"""
        text = update.message.text.strip()
        
        # Check if it's a username (alphanumeric, underscores, 5-32 chars)
        clean_text = text.replace('@', '').strip()
        
        if len(clean_text) < 5 or len(clean_text) > 32:
            await update.message.reply_text(
                "❌ *Invalid username format.*\n\n"
                "Telegram usernames must be 5-32 characters long "
                "and contain only letters, numbers, and underscores.\n\n"
                "*Example:* `IMMU_DONN` or `@username`",
                parse_mode=ParseMode.MARKDOWN
            )
            return
        
        # Process the username
        await self.process_username(update, context, clean_text)
    
    async def process_username(self, update: Update, context: CallbackContext, username: str):
        """Process username and fetch information"""
        # Send processing message
        processing_msg = await update.message.reply_text(
            f"🔍 *Searching for @{username}...*\n"
            f"Please wait while I fetch the information...",
            parse_mode=ParseMode.MARKDOWN
        )
        
        try:
            # Fetch data from API
            data = self.api_service.get_telegram_info(username)
            
            if not data:
                await processing_msg.edit_text(
                    "❌ *Service Unavailable*\n\n"
                    "The information service is currently unavailable. "
                    "Please try again later.",
                    parse_mode=ParseMode.MARKDOWN
                )
                return
            
            if not data.get('success', False):
                error_msg = data.get('error', 'Unknown error occurred')
                
                # User-friendly error messages
                if 'timeout' in data:
                    error_display = "⏱️ *Request Timeout*\n\nPlease try again in a moment."
                elif 'connection_error' in data:
                    error_display = "🌐 *Connection Error*\n\nCheck your internet connection."
                elif 'status_code' in data:
                    if data['status_code'] == 404:
                        error_display = f"❌ *User Not Found*\n\nUsername `@{username}` not found or profile is private."
                    elif data['status_code'] == 429:
                        error_display = "🚫 *Rate Limited*\n\nToo many requests. Please wait a moment."
                    else:
                        error_display = f"❌ *API Error {data['status_code']}*\n\n{error_msg}"
                elif 'username' in error_msg.lower() or 'not found' in error_msg.lower():
                    error_display = f"❌ *User Not Found*\n\nUsername `@{username}` not found or profile is private."
                else:
                    error_display = f"❌ *Error*\n\n{error_msg}"
                
                await processing_msg.edit_text(
                    error_display,
                    parse_mode=ParseMode.MARKDOWN
                )
                return
            
            # Format and send successful response
            formatted_response = self.format_telegram_info(data, username)
            
            # Create inline keyboard for actions
            keyboard = [
                [
                    InlineKeyboardButton("🔗 Open Profile", url=f"https://t.me/{username}"),
                    InlineKeyboardButton("💬 Direct Message", url=f"tg://resolve?domain={username}")
                ],
                [
                    InlineKeyboardButton("🔄 Search Again", callback_data="search_again"),
                    InlineKeyboardButton("📊 Full Details", callback_data=f"details_{username}")
                ]
            ]
            
            reply_markup = InlineKeyboardMarkup(keyboard)
            
            await processing_msg.edit_text(
                formatted_response,
                reply_markup=reply_markup,
                parse_mode=ParseMode.MARKDOWN,
                disable_web_page_preview=True
            )
            
        except Exception as e:
            logger.error(f"Error processing username {username}: {e}")
            await processing_msg.edit_text(
                "❌ *Processing Error*\n\n"
                "An unexpected error occurred while processing your request. "
                "Please try again later.",
                parse_mode=ParseMode.MARKDOWN
            )
    
    def format_telegram_info(self, data: dict, username: str) -> str:
        """Format Telegram information into readable message"""
        try:
            # Start building response
            response_lines = []
            response_lines.append(f"📱 *TELEGRAM PROFILE: @{username}*")
            response_lines.append("━" * 30)
            
            # Basic info
            if 'developer' in data:
                response_lines.append(f"*API By:* {data['developer']}")
            
            if 'timestamp' in data:
                from datetime import datetime
                try:
                    dt = datetime.fromtimestamp(data['timestamp'])
                    response_lines.append(f"*Fetched:* {dt.strftime('%Y-%m-%d %H:%M:%S')}")
                except:
                    pass
            
            response_lines.append("")
            
            # Profile information
            if 'data' in data and 'profile' in data['data']:
                profile = data['data']['profile']
                
                response_lines.append("*👤 PROFILE INFO*")
                response_lines.append(f"• *Name:* {profile.get('name', 'N/A')}")
                response_lines.append(f"• *Bio:* {profile.get('bio', 'N/A')}")
                
                # Status indicators
                status = []
                if profile.get('verified'):
                    status.append("✅ Verified")
                if profile.get('premium'):
                    status.append("⭐ Premium")
                if profile.get('has_photo'):
                    status.append("🖼️ Has Photo")
                
                if status:
                    response_lines.append(f"• *Status:* {', '.join(status)}")
                
                response_lines.append(f"• *Type:* {profile.get('profile_type', 'N/A').title()}")
                response_lines.append("")
            
            # Activity information
            if 'data' in data and 'activity' in data['data']:
                activity = data['data']['activity']
                
                response_lines.append("*📊 ACTIVITY*")
                response_lines.append(f"• *Status:* {activity.get('online_status', 'N/A').title()}")
                
                if 'last_seen' in activity:
                    response_lines.append(f"• *Last Seen:* {activity.get('last_seen', 'N/A')}")
                
                if 'subscribers' in activity:
                    response_lines.append(f"• *Subscribers:* {self.format_number(activity.get('subscribers', 0))}")
                
                if 'activity_score' in activity:
                    score = activity.get('activity_score', 0)
                    response_lines.append(f"• *Activity Score:* {score}/100")
                
                response_lines.append("")
            
            # Contacts
            if 'data' in data and 'contacts' in data['data']:
                contacts = data['data']['contacts']
                
                response_lines.append("*📞 CONTACTS*")
                response_lines.append(f"• *Profile:* {'Public 🔓' if contacts.get('is_public') else 'Private 🔒'}")
                
                if contacts.get('telegram_link'):
                    response_lines.append(f"• *Link:* {contacts.get('telegram_link')}")
                
                response_lines.append("")
            
            # Channels/Groups count
            if 'data' in data and 'channels_groups' in data['data']:
                channels = data['data']['channels_groups']
                if channels:
                    response_lines.append(f"*📢 LINKED CHANNELS/GROUPS:* {len(channels)}")
                    
                    # Show first 3 channels
                    for i, channel in enumerate(channels[:3]):
                        if i == 2 and len(channels) > 3:
                            response_lines.append(f"• ... and {len(channels) - 2} more")
                            break
                        if 'username' in channel:
                            response_lines.append(f"• @{channel['username']}")
                    
                    response_lines.append("")
            
            # Analysis
            if 'data' in data and 'analysis' in data['data']:
                analysis = data['data']['analysis']
                
                response_lines.append("*📈 ANALYSIS*")
                response_lines.append(f"• *Profile Quality:* {analysis.get('profile_quality', 'N/A').title()}")
                response_lines.append(f"• *Account Age:* {analysis.get('account_age', 'N/A')}")
                response_lines.append("")
            
            # Processing time
            processing_time = data.get('processing_time', data.get('response_time', 'N/A'))
            response_lines.append(f"⏱️ *Processing Time:* {processing_time}")
            
            return "\n".join(response_lines)
            
        except Exception as e:
            logger.error(f"Error formatting response: {e}")
            return f"📱 *TELEGRAM PROFILE: @{username}*\n\n⚠️ *Error formatting detailed information.*\n\nBasic information retrieved successfully."
    
    def format_number(self, num: int) -> str:
        """Format large numbers with K/M suffix"""
        if num >= 1000000:
            return f"{num/1000000:.1f}M"
        elif num >= 1000:
            return f"{num/1000:.1f}K"
        return str(num)
    
    async def button_callback(self, update: Update, context: CallbackContext):
        """Handle button callbacks"""
        query = update.callback_query
        await query.answer()
        
        data = query.data
        
        if data == "example":
            await query.edit_message_text(
                "📌 *Example Usage*\n\n"
                "Try searching for these example usernames:\n\n"
                "• `IMMU_DONN`\n"
                "• `telegram`\n"
                "• `durov`\n\n"
                "Or use the command:\n"
                "`/info username`",
                parse_mode=ParseMode.MARKDOWN
            )
        
        elif data == "help":
            await self.help_command(update, context)
        
        elif data == "stats":
            await query.edit_message_text(
                "📊 *Bot Statistics*\n\n"
                "*Service Status:* ✅ Operational\n"
                "*API Version:* 1.0\n"
                "*Requests Today:* Limited\n"
                "*Response Time:* < 2s\n\n"
                "The bot is currently working normally.",
                parse_mode=ParseMode.MARKDOWN
            )
        
        elif data == "search_again":
            await query.edit_message_text(
                "🔍 *Search Again*\n\n"
                "Please send a Telegram username:\n\n"
                "*Examples:*\n"
                "`IMMU_DONN`\n"
                "`@username`\n"
                "`telegram`",
                parse_mode=ParseMode.MARKDOWN
            )
        
        elif data.startswith("details_"):
            username = data.replace("details_", "")
            await query.edit_message_text(
                f"📋 *Full Details for @{username}*\n\n"
                "To get full details, please use the search command:\n\n"
                f"`/info {username}`\n\n"
                "This will fetch the complete profile information.",
                parse_mode=ParseMode.MARKDOWN
            )
    
    async def error_handler(self, update: Update, context: CallbackContext):
        """Log errors and send user-friendly message"""
        logger.error(f"Update {update} caused error {context.error}", exc_info=context.error)
        
        # Try to send error message to user
        try:
            if update and update.effective_message:
                await update.effective_message.reply_text(
                    "❌ *An error occurred*\n\n"
                    "Please try again in a moment. "
                    "If the problem persists, contact support.",
                    parse_mode=ParseMode.MARKDOWN
                )
        except:
            pass
    
    def run(self):
        """Run the bot"""
        logger.info("🤖 Telegram Info Bot is starting...")
        print("=" * 50)
        print("🤖 TELEGRAM INFO BOT")
        print("=" * 50)
        print(f"Bot Token: {'✓ Set' if TELEGRAM_BOT_TOKEN else '✗ Missing'}")
        print(f"API Key: {'✓ Set' if API_KEY else '✗ Not Required'}")
        print("=" * 50)
        
        if not TELEGRAM_BOT_TOKEN:
            print("❌ ERROR: TELEGRAM_BOT_TOKEN not found in .env file!")
            print("Please add your bot token to the .env file.")
            return
        
        print("✅ Bot is running... Press Ctrl+C to stop.")
        print("=" * 50)
        
        # Run the bot
        self.application.run_polling(
            allowed_updates=Update.ALL_TYPES,
            drop_pending_updates=True
        )

def main():
    """Main function to start the bot"""
    try:
        bot = TelegramBot(TELEGRAM_BOT_TOKEN)
        bot.run()
    except KeyboardInterrupt:
        print("\n👋 Bot stopped by user.")
    except Exception as e:
        logger.error(f"Fatal error: {e}")
        print(f"❌ Fatal error: {e}")

if __name__ == '__main__':
    main()
