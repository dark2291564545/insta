import os
import requests
import logging
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, MessageHandler, filters, CallbackContext, CallbackQueryHandler
from telegram.constants import ParseMode
from dotenv import load_dotenv
import json

# Load environment variables
load_dotenv()

# Configure logging
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# Get credentials
TELEGRAM_BOT_TOKEN = os.getenv('TELEGRAM_BOT_TOKEN')

class TelegramInfoService:
    """Service to fetch Telegram user information from API"""
    
    def __init__(self):
        self.base_url = "https://akashhacker.gt.tc/telegram.php"
        self.session = requests.Session()
        self.session.timeout = 10
        
        # Set default headers
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Accept': 'application/json',
        }
    
    def get_telegram_info(self, username: str):
        """
        Fetch Telegram profile information
        """
        try:
            # Clean username
            clean_username = username.replace('@', '').strip()
            
            logger.info(f"Fetching info for: {clean_username}")
            
            # Make API request
            response = self.session.get(
                self.base_url,
                params={'username': clean_username},
                headers=self.headers,
                timeout=10
            )
            
            # Check response
            if response.status_code != 200:
                logger.error(f"API Error: {response.status_code}")
                return None
            
            # Parse JSON
            data = response.json()
            
            if data.get('success'):
                logger.info(f"Successfully fetched data for {clean_username}")
                return data
            else:
                logger.error(f"API reported failure for {clean_username}")
                return None
                
        except requests.exceptions.Timeout:
            logger.error(f"Timeout for {username}")
            return None
        except requests.exceptions.RequestException as e:
            logger.error(f"Request error: {e}")
            return None
        except json.JSONDecodeError:
            logger.error(f"JSON decode error for {username}")
            return None
        except Exception as e:
            logger.error(f"Unexpected error: {e}")
            return None

class TelegramBot:
    def __init__(self, token):
        self.application = Application.builder().token(token).build()
        self.api_service = TelegramInfoService()
        self.setup_handlers()
    
    def setup_handlers(self):
        """Setup all bot handlers"""
        self.application.add_handler(CommandHandler("start", self.start_command))
        self.application.add_handler(CommandHandler("help", self.help_command))
        self.application.add_handler(CommandHandler("info", self.info_command))
        self.application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, self.handle_message))
        self.application.add_error_handler(self.error_handler)
    
    async def start_command(self, update: Update, context: CallbackContext):
        """Send welcome message"""
        user = update.effective_user
        
        welcome_text = f"""
👋 *Welcome {user.first_name}!*

🤖 *Telegram Info Bot*

I can fetch information about Telegram users.

*How to use:*
1. Send a Telegram username directly
   Example: `IMMU_DONN` or `@username`

2. Use command:
   `/info username`
   Example: `/info IMMU_DONN`

Try it now! Send me a Telegram username.
        """
        
        keyboard = [
            [InlineKeyboardButton("Try Example", callback_data="example")],
            [InlineKeyboardButton("Help", callback_data="help")]
        ]
        
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await update.message.reply_text(
            welcome_text,
            reply_markup=reply_markup,
            parse_mode=ParseMode.MARKDOWN
        )
    
    async def help_command(self, update: Update, context: CallbackContext):
        """Send help message"""
        help_text = """
*🤖 Help Guide*

*Commands:*
/start - Start the bot
/help - Show this help
/info <username> - Get user info

*Examples:*
`IMMU_DONN`
`@username`
`/info username`

*Note:* Only works with public Telegram profiles.
        """
        
        await update.message.reply_text(help_text, parse_mode=ParseMode.MARKDOWN)
    
    async def info_command(self, update: Update, context: CallbackContext):
        """Handle /info command"""
        if not context.args:
            await update.message.reply_text(
                "Please provide a username.\nExample: `/info IMMU_DONN`",
                parse_mode=ParseMode.MARKDOWN
            )
            return
        
        username = context.args[0]
        await self.process_username(update, username)
    
    async def handle_message(self, update: Update, context: CallbackContext):
        """Handle direct username input"""
        text = update.message.text.strip()
        clean_text = text.replace('@', '').strip()
        
        if 5 <= len(clean_text) <= 32:
            await self.process_username(update, clean_text)
        else:
            await update.message.reply_text(
                "Please send a valid Telegram username.\nExample: `IMMU_DONN`",
                parse_mode=ParseMode.MARKDOWN
            )
    
    async def process_username(self, update: Update, username: str):
        """Process username and fetch info"""
        # Send processing message
        processing_msg = await update.message.reply_text(
            f"🔍 *Searching for @{username}...*",
            parse_mode=ParseMode.MARKDOWN
        )
        
        # Fetch data
        data = self.api_service.get_telegram_info(username)
        
        if not data:
            await processing_msg.edit_text(
                f"❌ *Error*\n\nCould not fetch information for @{username}.\n"
                "The user might not exist or profile is private.",
                parse_mode=ParseMode.MARKDOWN
            )
            return
        
        # Format response
        response_text = self.format_response(data, username)
        
        # Create buttons
        keyboard = [
            [
                InlineKeyboardButton("🔗 Open Profile", url=f"https://t.me/{username}"),
                InlineKeyboardButton("💬 Message", url=f"tg://resolve?domain={username}")
            ]
        ]
        
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await processing_msg.edit_text(
            response_text,
            reply_markup=reply_markup,
            parse_mode=ParseMode.MARKDOWN,
            disable_web_page_preview=True
        )
    
    def format_response(self, data: dict, username: str) -> str:
        """Format API response"""
        try:
            lines = []
            lines.append(f"📱 *Telegram Profile: @{username}*")
            lines.append("─" * 30)
            
            if 'data' in data:
                profile_data = data['data']
                
                # Profile info
                if 'profile' in profile_data:
                    profile = profile_data['profile']
                    lines.append(f"👤 *Name:* {profile.get('name', 'N/A')}")
                    lines.append(f"📝 *Bio:* {profile.get('bio', 'N/A')}")
                    
                    # Status
                    status = []
                    if profile.get('verified'):
                        status.append("✅ Verified")
                    if profile.get('premium'):
                        status.append("⭐ Premium")
                    if status:
                        lines.append(f"📊 *Status:* {', '.join(status)}")
                
                # Activity
                if 'activity' in profile_data:
                    activity = profile_data['activity']
                    lines.append(f"🟢 *Status:* {activity.get('online_status', 'N/A').title()}")
                    
                    if 'last_seen' in activity:
                        lines.append(f"⏰ *Last Seen:* {activity.get('last_seen')}")
                    
                    if 'subscribers' in activity:
                        lines.append(f"👥 *Subscribers:* {activity.get('subscribers')}")
                
                # Analysis
                if 'analysis' in profile_data:
                    analysis = profile_data['analysis']
                    lines.append(f"📈 *Profile Quality:* {analysis.get('profile_quality', 'N/A').title()}")
                    lines.append(f"📅 *Account Age:* {analysis.get('account_age', 'N/A')}")
            
            # Processing time
            if 'processing_time' in data:
                lines.append(f"⏱️ *Fetched in:* {data['processing_time']}")
            
            if 'developer' in data:
                lines.append(f"👨‍💻 *API by:* {data['developer']}")
            
            return "\n".join(lines)
            
        except Exception as e:
            logger.error(f"Format error: {e}")
            return f"📱 *Profile: @{username}*\n\nInformation retrieved successfully."
    
    async def button_callback(self, update: Update, context: CallbackContext):
        """Handle button clicks"""
        query = update.callback_query
        await query.answer()
        
        if query.data == "example":
            await query.edit_message_text(
                "*Example Usage:*\n\n"
                "Try searching for:\n"
                "• `IMMU_DONN`\n"
                "• `telegram`\n"
                "• `durov`\n\n"
                "Or any public Telegram username.",
                parse_mode=ParseMode.MARKDOWN
            )
        elif query.data == "help":
            await self.help_command(update, context)
    
    async def error_handler(self, update: Update, context: CallbackContext):
        """Handle errors"""
        logger.error(f"Error: {context.error}")
    
    def run(self):
        """Start the bot"""
        logger.info("Starting Telegram Info Bot...")
        print("🤖 Bot is starting...")
        self.application.run_polling(allowed_updates=Update.ALL_TYPES)

def main():
    """Main function"""
    if not TELEGRAM_BOT_TOKEN:
        print("❌ ERROR: TELEGRAM_BOT_TOKEN not found!")
        print("Please add it to your Render environment variables.")
        return
    
    bot = TelegramBot(TELEGRAM_BOT_TOKEN)
    bot.run()

if __name__ == '__main__':
    main()
