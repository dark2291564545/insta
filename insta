import os
import requests
import logging
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, CallbackContext
from dotenv import load_dotenv

# Load environment variables
load_dotenv()

# Configure logging
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

TELEGRAM_BOT_TOKEN = os.getenv('TELEGRAM_BOT_TOKEN')

class TelegramInfoBot:
    def __init__(self, token):
        self.application = Application.builder().token(token).build()
        self.setup_handlers()
    
    def setup_handlers(self):
        self.application.add_handler(CommandHandler("start", self.start_command))
        self.application.add_handler(CommandHandler("info", self.info_command))
        self.application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, self.handle_message))
        self.application.add_error_handler(self.error_handler)
    
    async def start_command(self, update: Update, context: CallbackContext):
        await update.message.reply_text(
            "🤖 *Telegram Info Bot*\n\n"
            "Send me a Telegram username to get information.\n"
            "Example: `IMMU_DONN` or `@username`\n\n"
            "Or use: `/info username`",
            parse_mode='Markdown'
        )
    
    async def info_command(self, update: Update, context: CallbackContext):
        if not context.args:
            await update.message.reply_text("Please provide a username. Example: `/info IMMU_DONN`", parse_mode='Markdown')
            return
        
        username = context.args[0]
        await self.get_telegram_info(update, username)
    
    async def handle_message(self, update: Update, context: CallbackContext):
        text = update.message.text.strip().replace('@', '')
        await self.get_telegram_info(update, text)
    
    async def get_telegram_info(self, update: Update, username: str):
        try:
            # Send processing message
            msg = await update.message.reply_text(f"🔍 Searching for @{username}...")
            
            # Call API
            response = requests.get(
                "https://akashhacker.gt.tc/telegram.php",
                params={'username': username},
                timeout=10
            )
            
            if response.status_code == 200:
                data = response.json()
                
                if data.get('success'):
                    # Format response
                    profile = data['data']['profile']
                    contacts = data['data']['contacts']
                    activity = data['data']['activity']
                    
                    response_text = (
                        f"📱 *Telegram Profile: @{username}*\n\n"
                        f"👤 *Name:* {profile.get('name', 'N/A')}\n"
                        f"📝 *Bio:* {profile.get('bio', 'N/A')}\n"
                        f"🔗 *Link:* {contacts.get('telegram_link', 'N/A')}\n"
                        f"👥 *Subscribers:* {activity.get('subscribers', 'N/A')}\n"
                        f"📊 *Activity Score:* {activity.get('activity_score', 'N/A')}/100\n\n"
                        f"⏱️ *API Time:* {data.get('processing_time', 'N/A')}"
                    )
                    
                    await msg.edit_text(response_text, parse_mode='Markdown')
                else:
                    await msg.edit_text(f"❌ User @{username} not found or profile is private.")
            else:
                await msg.edit_text("❌ API Error. Please try again later.")
                
        except Exception as e:
            logger.error(f"Error: {e}")
            try:
                await msg.edit_text("❌ An error occurred. Please try again.")
            except:
                await update.message.reply_text("❌ An error occurred. Please try again.")
    
    async def error_handler(self, update: Update, context: CallbackContext):
        logger.error(f"Error: {context.error}")
    
    def run(self):
        logger.info("Bot starting...")
        self.application.run_polling(allowed_updates=Update.ALL_TYPES)

def main():
    if not TELEGRAM_BOT_TOKEN:
        print("❌ Error: TELEGRAM_BOT_TOKEN not found!")
        return
    
    bot = TelegramInfoBot(TELEGRAM_BOT_TOKEN)
    bot.run()

if __name__ == '__main__':
    main()
