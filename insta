class TelegramInfoService:
    """Service to fetch Telegram user information from API"""
    
    def __init__(self):
        self.base_url = "https://akashhacker.gt.tc/telegram.php"
        self.api_key = API_KEY
        self.session = requests.Session()
        self.session.timeout = 15
        
        # Set default headers
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Accept': 'application/json',
            'Accept-Language': 'en-US,en;q=0.9',
        }
        
        # Add API key if provided
        if self.api_key:
            self.headers['Authorization'] = f'Bearer {self.api_key}'
            self.headers['API-Key'] = self.api_key
    
    def get_telegram_info(self, username: str):
        """
        Fetch Telegram profile information for given username
        
        Args:
            username: Telegram username (without @)
            
        Returns:
            dict: API response data or None if error
        """
        try:
            # Clean username (remove @ if present)
            clean_username = username.replace('@', '').strip()
            
            # Prepare URL with parameters
            params = {'username': clean_username}
            
            logger.info(f"Fetching info for username: {clean_username}")
            
            # Make API request
            start_time = time.time()
            response = self.session.get(
                self.base_url,
                params=params,
                headers=self.headers,
                timeout=15
            )
            response_time = time.time() - start_time
            
            logger.info(f"API Response Time: {response_time:.2f}s | Status: {response.status_code}")
            
            # Check if request was successful
            if response.status_code != 200:
                logger.error(f"API returned status code: {response.status_code}")
                logger.error(f"Response text: {response.text[:200]}")
                return {
                    'success': False,
                    'error': f"API Error: Status Code {response.status_code}",
                    'status_code': response.status_code
                }
            
            # Try to parse JSON response
            try:
                data = response.json()
                
                # Validate response structure
                if not isinstance(data, dict):
                    logger.error(f"Invalid response type: {type(data)}")
                    return {
                        'success': False,
                        'error': 'Invalid API response format',
                        'raw_response': str(data)[:500]
                    }
                
                # Check if API indicates success
                if data.get('success') is False:
                    error_msg = data.get('error', 'Unknown API error')
                    logger.error(f"API reported failure: {error_msg}")
                    return {
                        'success': False,
                        'error': error_msg,
                        'api_response': data
                    }
                
                # Add response time to data
                data['response_time'] = f"{response_time:.2f}s"
                
                logger.info(f"Successfully fetched data for {clean_username}")
                return data
                
            except json.JSONDecodeError as e:
                logger.error(f"JSON decode error: {e}")
                logger.error(f"Raw response: {response.text[:500]}")
                return {
                    'success': False,
                    'error': f'Invalid JSON response: {str(e)}',
                    'raw_response': response.text[:500]
                }
                
        except requests.exceptions.Timeout:
            logger.error(f"Request timeout for username: {username}")
            return {
                'success': False,
                'error': 'Request timeout. Please try again.',
                'timeout': True
            }
            
        except requests.exceptions.ConnectionError:
            logger.error(f"Connection error for username: {username}")
            return {
                'success': False,
                'error': 'Connection error. Please check your internet.',
                'connection_error': True
            }
            
        except requests.exceptions.RequestException as e:
            logger.error(f"Request exception for {username}: {e}")
            return {
                'success': False,
                'error': f'Network error: {str(e)}',
                'exception': str(e)
            }
            
        except Exception as e:
            logger.error(f"Unexpected error for {username}: {e}")
            return {
                'success': False,
                'error': f'Unexpected error: {str(e)}',
                'exception_type': type(e).__name__
            }

class TelegramBot:
    def __init__(self, token):
        self.application = Application.builder().token(token).build()
        self.api_service = TelegramInfoService()
        self.setup_handlers()
    
    def setup_handlers(self):
        """Setup all bot handlers"""
        # Command handlers
        self.application.add_handler(CommandHandler("start", self.start_command))
        self.application.add_handler(CommandHandler("help", self.help_command))
        self.application.add_handler(CommandHandler("info", self.info_command))
        self.application.add_handler(CommandHandler("search", self.info_command))
        self.application.add_handler(CommandHandler("about", self.about_command))
        
        # Message handler for direct username input
        self.application.add_handler(MessageHandler(
            filters.TEXT & ~filters.COMMAND, 
            self.handle_message
        ))
        
        # Callback query handler for buttons
        self.application.add_handler(CallbackQueryHandler(self.button_callback))
        
        # Error handler
        self.application.add_error_handler(self.error_handler)
    
